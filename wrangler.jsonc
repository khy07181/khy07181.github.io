// 블로그를 dochigarden.com/blog 하위 경로로 서빙하는 assets-only Worker.
// 루트(dochigarden.com)는 별도 Cloudflare Pages 프로젝트(khy07181/dochigarden)가 서빙하고,
// 아래 routes가 /blog 경로만 이 Worker로 가져온다.
// 에셋은 URL 경로를 그대로 미러링해야 하므로 빌드 결과(public/)를 dist/blog/로 옮겨 배포한다.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dochigarden-blog",
  "compatibility_date": "2026-10-01",
  "routes": [
    { "pattern": "dochigarden.com/blog", "zone_name": "dochigarden.com" },
    { "pattern": "dochigarden.com/blog/*", "zone_name": "dochigarden.com" },
  ],
  // *.workers.dev / 프리뷰 URL에 중복 사본이 생기지 않도록 끈다.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
