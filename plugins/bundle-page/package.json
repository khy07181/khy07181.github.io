{
  "name": "@local/bundle-page",
  "version": "1.0.0",
  "description": "Renders page-bundle posts (post/post.md -> post/index) as content pages instead of folder pages",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "exports": {
    ".": { "import": "./dist/index.js" },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "engines": { "node": ">=22" },
  "quartz": {
    "name": "bundle-page",
    "displayName": "Bundle Page",
    "category": "pageType",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {}
  }
}
